# Normaliza quebras de linha no repositório
* text=auto eol=lf

# Scripts shell e arquivos de contêiner: sempre LF (rodam em Linux)
*.sh        text eol=lf
mvnw        text eol=lf
Dockerfile  text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf

# Arquivos do Windows: sempre CRLF
*.cmd       text eol=crlf
*.bat       text eol=crlf

# Binários: sem conversão
*.jar       binary
*.png       binary
*.jpg       binary
